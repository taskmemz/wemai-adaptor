{
  "manifest_version": 2,
  "id": "taskmemz.wemai-adapter",
  "version": "1.0.0",
  "name": "WeMai 微信适配器",
  "description": "接收 pyweixin / WeFlow 客户端的 TCP 连接，将微信消息桥接到 MaiBot。",
  "author": {
    "name": "taskmemz",
    "url": "https://github.com/taskmemz"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/taskmemz/wemai-adaptor",
    "homepage": "https://github.com/taskmemz/wemai-adaptor",
    "documentation": "https://github.com/taskmemz/wemai-adaptor",
    "issues": "https://github.com/taskmemz/wemai-adaptor/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "999.999.999"
  },
  "dependencies": [],
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "message-square"
    }
  },
  "capabilities": [
    "send_message"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN", "en-US"]
  }
}
